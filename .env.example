# Copia este archivo a .env (para "vercel dev" local) y pon tu clave real.
# En produccion NO se usa este archivo: la clave se configura en
# Vercel -> Project Settings -> Environment Variables.

# Clave de la API de Anthropic (console.anthropic.com) que usa /api/chat.js
# para el asistente virtual del sitio.
ANTHROPIC_API_KEY=sk-ant-...
